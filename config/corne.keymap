#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_de.h"
#include "pos.h"

/ {
	behaviors {
		hm_a: hm_a {
			compatible = "zmk,behavior-hold-tap";
			label = "HM_A";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			bindings = < &kp DE_A &kp LCTRL >;
		};

		hm_s: hm_s {
			compatible = "zmk,behavior-hold-tap";
			label = "HM_S";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			bindings = < &kp DE_S &kp LALT >;
		};

		hm_d: hm_d {
			compatible = "zmk,behavior-hold-tap";
			label = "HM_D";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			bindings = < &kp DE_D &kp LGUI >;
		};

		hm_f: hm_f {
			compatible = "zmk,behavior-hold-tap";
			label = "HM_F";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			bindings = < &kp DE_F &kp LSHFT >;
		};

		hm_j: hm_j {
			compatible = "zmk,behavior-hold-tap";
			label = "HM_J";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			bindings = < &kp DE_J &kp RSHFT >;
		};

		hm_k: hm_k {
			compatible = "zmk,behavior-hold-tap";
			label = "HM_K";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			bindings = < &kp DE_K &kp RGUI >;
		};

		hm_l: hm_l {
			compatible = "zmk,behavior-hold-tap";
			label = "HM_L";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			bindings = < &kp DE_L &kp RALT >;
		};

		hm_oe: hm_oe {
			compatible = "zmk,behavior-hold-tap";
			label = "HM_OE";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			bindings = < &kp DE_O_UMLAUT &kp RCTRL >;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Base";
			bindings = <
				&kp TAB   &kp DE_Q &kp DE_W     &kp DE_E &kp DE_R &kp DE_T &kp DE_Z &kp DE_U &kp DE_I     &kp DE_O   &kp DE_P     &kp BSPC
				&kp LCTRL &hm_a    &hm_s        &hm_d    &hm_f    &kp DE_G &kp DE_H &hm_j    &hm_k        &hm_l      &hm_oe       &kp DE_A_UMLAUT
				&kp LSHFT &kp DE_Y &kp DE_X     &kp DE_C &kp DE_V &kp DE_B &kp DE_N &kp DE_M &kp DE_COMMA &kp DE_DOT &kp DE_MINUS &kp ESC
				&kp LGUI  &mo 1    &kp DE_SPACE &kp RET  &mo 2    &kp RALT
			>;
		};

		lower_layer {
			display-name = "Lower";
			bindings = <
				&kp TAB    &kp DE_N1    &kp DE_N2    &kp DE_N3    &kp DE_N4    &kp DE_N5    &kp DE_N6 &kp DE_N7 &kp DE_N8 &kp DE_N9 &kp DE_N0 &kp BSPC
				&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
				&kp LSHFT  &trans       &trans       &trans       &trans       &trans       &trans    &trans    &trans    &trans    &trans    &trans
				&kp LGUI   &trans       &kp DE_SPACE &kp RET      &trans       &kp RALT
			>;
		};

		raise_layer {
			display-name = "Raise";
			bindings = <
				&kp TAB   &kp DE_EXCL &kp DE_DQT   &kp DE_SECT &kp DE_DLLR &kp DE_PRCNT &kp DE_AMPS   &kp DE_FSLH  &kp KP_MULTIPLY &kp DE_RPAR &kp DE_EQUAL &kp BSPC
				&kp LCTRL &trans      &trans       &trans      &trans      &trans       &kp DE_ESZETT &kp DE_ACUTE &kp DE_U_UMLAUT &kp DE_PLUS &kp DE_HASH  &kp DE_CARET
				&kp LSHFT &trans      &trans       &trans      &trans      &trans       &kp DE_QMARK  &kp DE_GRAVE &kp DE_LBRC     &kp DE_STAR &kp DE_APOS  &kp DE_DEG
				&kp LGUI  &trans      &kp DE_SPACE &kp RET     &trans      &kp RALT
			>;
		};

		extra_1 { status = "reserved"; };
		extra_2 { status = "reserved"; };
		extra_3 { status = "reserved"; };
	};
};
