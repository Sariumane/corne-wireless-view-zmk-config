	!!! Combos sind eigener block und kein behavior!!!
	combos {
		compatible = "zmk,combos";

		A + S gleichzeitig = ESC 
		combo_esc {
			timeout-ms = <40>;
			key-positions = <12 13>; /* <- physische Key-Positionen 
			bindings = <&kp ESC>;
		};
	};

	behaviors{
		hold-tap beispiel
		ht: ht {
			compatible = "zmk,behavior-hold-tap";
			label = "HT";
			#binding-cells = <2>;   -> anzahl der argumente beim aufruf in der keymap

			 Welche Behaviors werden genutzt 
			bindings = <&kp>, <&kp>;

			 typische Defaults 
			flavor = "balanced";
			tapping-term-ms = <200>;
		};


		tap-dance beispiel das einen hold-tap aufruft:
		ht_ctrl_esc: ht_ctrl_esc {
			compatible = "zmk,behavior-hold-tap";
			label = "HT_CTRL_ESC";
			#binding-cells = <2>;
			bindings = <&kp>, <&kp>;
			tapping-term-ms = <200>;
		};

		td_example: td_example {
			compatible = "zmk,behavior-tap-dance";
			label = "TD_EXAMPLE";
			#binding-cells = <0>;
			tapping-term-ms = <200>;
			bindings = <&kp A>, <&ht_ctrl_esc LCTRL ESC>;
		};


		mod-morph beispiel
		mm_sc_col: mm_sc_col {
			compatible = "zmk,behavior-mod-morph";
			label = "MM_SC_COL";
			#binding-cells = <0>;
			mods = <MOD_LSFT>;
			bindings = <&kp SEMI>, <&kp COLON>;
		};

		
		macro beispiel:
		m_parens: m_parens {
			compatible = "zmk,behavior-macro";
			label = "M_PARENS";
			#binding-cells = <0>;
			bindings = <
				&kp LPAR
				&kp RPAR
			>;
		};

		In behavior-macro gibt es diese Bausteine:
		&kp X → tap (press + release)
		&macro_press &kp X
		&macro_release &kp X
		&macro_tap &kp X (explizit, selten nötig)
		&macro_pause <ms>
		
	}



	layer semantik:
	&mo 1 		-> toggle layer 1 on hold
	&lt 1 space -> layer 1 on hold, space on tap
	&tog 1		-> quasi nutzlos weil stapelt layer
	&sl 1		-> aktiviert layer für einen key stroke
	&to 1		-> toggle den man benutzen kann

	anderes:
	&caps_word	-> wenn ausgelöst alles großgeschrieben, sobald eine nicht alphanumerische taste gedrückt wird.
	&sk LSHFT	-> nächster key bekommt diesen mod 
	&kt LALT	-> toggled den key
*/



#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_de.h"
#include "pos.h"

/ {
	behaviors {
		hm_1: hm_1 {
			compatible = "zmk,behavior-hold-tap";
			label = "HM_1";
			#binding-cells = <2>;

			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;

			/* nur Behavior-Referenzen */
			bindings = <&kp>, <&kp>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Base";
			bindings = <
				&kp TAB   			&kp DE_Q 			&kp DE_W     		&kp DE_E 			&kp DE_R 			&kp DE_T 			&kp DE_Z 	&kp DE_U 			&kp DE_I     		&kp DE_O            &kp DE_P       				&kp BSPC
				&kp LCTRL 			&hm_1 LGUI DE_A     &hm_1 LALT DE_S   	&hm_1 LCTRL DE_D  	&hm_1 LSHFT DE_F  	&kp DE_G 			&kp DE_H	&hm_1 RSHFT DE_J    &hm_1 RCTRL DE_K    &hm_1 RALT DE_L  	&hm_1 RGUI DE_O_UMLAUT  	&kp DE_A_UMLAUT
				&kp LSHFT 			&kp DE_Y 			&kp DE_X     		&kp DE_C 			&kp DE_V 			&kp DE_B 			&kp DE_N 	&kp DE_M 			&kp DE_COMMA 		&kp DE_DOT    		&kp DE_MINUS   				&kp ESC
																			&kp LGUI  			&mo 1    			&kp DE_SPACE 		&kp RET  	&mo 2    			&kp RALT
			>;
		};

		lower_layer {
			display-name = "Lower";
			bindings = <
				&kp TAB    &kp DE_N1    &kp DE_N2    &kp DE_N3    &kp DE_N4    &kp DE_N5    &kp DE_N6 &kp DE_N7 &kp DE_N8 &kp DE_N9 &kp DE_N0 &kp BSPC
				&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
				&kp LSHFT  &trans       &trans       &trans       &trans       &trans       &trans    &trans    &trans    &trans    &trans    &trans
				&kp LGUI   &trans       &kp DE_SPACE &kp RET      &trans       &kp RALT
			>;
		};

		raise_layer {
			display-name = "Raise";
			bindings = <
				&kp TAB   &kp DE_EXCL &kp DE_DQT   &kp DE_SECT &kp DE_DLLR &kp DE_PRCNT &kp DE_AMPS   &kp DE_FSLH  &kp KP_MULTIPLY &kp DE_RPAR &kp DE_EQUAL &kp BSPC
				&kp LCTRL &trans      &trans       &trans      &trans      &trans       &kp DE_ESZETT &kp DE_ACUTE &kp DE_U_UMLAUT &kp DE_PLUS &kp DE_HASH  &kp DE_CARET
				&kp LSHFT &trans      &trans       &trans      &trans      &trans       &kp DE_QMARK  &kp DE_GRAVE &kp DE_LBRC     &kp DE_STAR &kp DE_APOS  &kp DE_DEG
				&kp LGUI  &trans      &kp DE_SPACE &kp RET     &trans      &kp RALT
			>;
		};

		extra_1 { status = "reserved"; };
		extra_2 { status = "reserved"; };
		extra_3 { status = "reserved"; };
	};
};
